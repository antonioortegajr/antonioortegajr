#!/usr/bin/env bash
# Deterministic gate for factory job branches.
# Usage: factory/bin/gate <issue-number> <round>
set -uo pipefail

usage() {
  echo "usage: factory/bin/gate <issue-number> <round>" >&2
  exit 2
}

if [[ $# -ne 2 ]]; then
  usage
fi

N="$1"
ROUND="$2"

if [[ ! "$N" =~ ^[0-9]+$ || ! "$ROUND" =~ ^[0-9]+$ ]]; then
  usage
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG="$REPO/factory/config.json"

if [[ ! -f "$CONFIG" ]]; then
  echo "error: missing config: $CONFIG" >&2
  exit 2
fi

base_branch="$(jq -r '.base_branch' "$CONFIG")"
branch_prefix="$(jq -r '.branch_prefix' "$CONFIG")"
worktree_root="$(jq -r '.worktree_root' "$CONFIG")"

expected_branch="${branch_prefix}${N}"
base_ref="origin/${base_branch}"

WT="$REPO/$worktree_root/issue-$N"
if [[ ! -d "$WT" ]]; then
  echo "error: worktree not found: $WT" >&2
  exit 2
fi
WT="$(cd "$WT" && pwd -P)"

current_branch="$(git -C "$WT" branch --show-current 2>/dev/null || true)"
if [[ "$current_branch" != "$expected_branch" ]]; then
  echo "error: worktree branch is '${current_branch}', expected '${expected_branch}'" >&2
  exit 2
fi

JOB="$REPO/factory/jobs/issue-$N/round-$ROUND"
mkdir -p "$JOB"

reasons=()
checks_ran=0

if ! git -C "$WT" fetch origin "$base_branch" >/dev/null 2>&1; then
  reasons+=("could not fetch ${base_ref}")
fi

# 1. Clean tree
if [[ -n "$(git -C "$WT" status --porcelain)" ]]; then
  reasons+=("working tree is not clean")
fi

# 2. Has commits ahead of base
commit_count="$(git -C "$WT" rev-list --count "${base_ref}..HEAD" 2>/dev/null || echo 0)"
if [[ "$commit_count" -eq 0 ]]; then
  reasons+=("branch has no commits ahead of ${base_ref}")
fi

# 3. Protected paths
changed_files="$(git -C "$WT" diff --name-only "${base_ref}...HEAD" 2>/dev/null || true)"
protected_paths=()
while IFS= read -r path; do
  protected_paths+=("$path")
done < <(jq -r '.protected_paths[]' "$CONFIG")

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  for protected in "${protected_paths[@]}"; do
    if [[ "$protected" == */ ]]; then
      if [[ "$file" == "$protected"* ]]; then
        reasons+=("protected path changed: $file")
        break
      fi
    elif [[ "$file" == "$protected" ]]; then
      reasons+=("protected path changed: $file")
      break
    fi
  done
done <<< "$changed_files"

# 4. Checks (only when prechecks pass)
if [[ ${#reasons[@]} -eq 0 ]]; then
  checks_ran=1
  if (cd "$WT" && bash "$REPO/factory/checks.sh") >"$JOB/checks.log" 2>&1; then
    :
  else
    rc=$?
    checks_ran=2
    reasons+=("checks failed (exit $rc)")
  fi
fi

if [[ ${#reasons[@]} -eq 0 ]]; then
  {
    echo "GATE: PASS"
    echo
    echo "## Reasons"
    echo "- None."
  } > "$JOB/gate.md"
  echo "issue-$N round $ROUND: GATE PASS"
  exit 0
fi

{
  echo "GATE: FAIL"
  echo
  echo "## Reasons"
  printf -- '- %s\n' "${reasons[@]}"
  if [[ "$checks_ran" -eq 2 ]]; then
    echo
    echo "## Log tail"
    echo '```'
    tail -n 80 "$JOB/checks.log"
    echo '```'
  fi
} > "$JOB/gate.md"

if [[ "$checks_ran" -eq 2 ]]; then
  echo "issue-$N round $ROUND: GATE FAIL (checks failed)"
else
  echo "issue-$N round $ROUND: GATE FAIL (prechecks failed)"
fi
exit 1
